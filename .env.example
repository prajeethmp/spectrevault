# SpectreVault Configuration
# Note: SpectreVault is Zero-Knowledge by design; no plaintext is ever sent to the server.

# Node environment
NODE_ENV=production

# Server Port (default: 3000)
PORT=3000

# Vault Memory Store Cleanup Interval in seconds (default: 60)
VAULT_CLEANUP_INTERVAL_SECONDS=60

# Max allowed ciphertext size in bytes (default: 10485760 -> 10MB)
MAX_CIPHERTEXT_SIZE_BYTES=10485760

# Default TTL in minutes (default: 60)
DEFAULT_TTL_MINUTES=60

# Max TTL in minutes (default: 10080 -> 7 days)
MAX_TTL_MINUTES=10080
